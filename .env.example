# ----------------------------------------------------------------------------
# PSIT Startup & Incubation Foundation (PSIT-SIF) Environment Configuration
# ----------------------------------------------------------------------------

# 1. OPTIONAL: Live Backend URL
# If hosting Express on a cloud provider (Render, Railway, Fly.io, or VPS),
# specify the full URL here. Example: https://psit-sif-api.onrender.com
# If left blank, public pages use bundled static JSON data. Admin sign-in,
# contact submissions, and CMS changes require a deployed backend.
VITE_API_URL=

# 2. OPTIONAL: GitHub Pages Subpath
# Set automatically by `npm run build:ghpages`.
# Example: /PSIT_SIF/
VITE_BASE_PATH=